// Iffchat — IM desktop client. Left nav (avatar/chat/friends), middle column
// (search + list), right chat pane. Pages: chat (recent conversations),
// friends (new-friends entry + contacts), new-friends (apply list).
// Layout folded from the Iffchat visual prototype.
import { Button, LineEdit, ScrollView, TextEdit, VerticalBox, HorizontalBox } from "std-widgets.slint";

export component MainWindow inherits Window {
    title: "Iffchat";
    width: 1100px;
    height: 900px;
    background: #ffffff;

    in-out property <string> server-host: "127.0.0.1:10086";
    in-out property <string> username: "";
    in-out property <string> password: "";
    in-out property <string> login-status: "";
    in-out property <bool> logged-in: false;
    // auth: 0 = login, 1 = register, 2 = reset password
    in-out property <int> auth-mode: 0;
    in-out property <string> email: "";
    in-out property <string> confirm-password: "";
    in-out property <string> verify-code: "";
    // page: 0 = chat, 1 = friends, 2 = new friends
    in-out property <int> page: 0;
    // friends
    in-out property <[string]> friend-names: [];
    in-out property <[int]> unread-flags: [];
    // recent conversations
    in-out property <[string]> conv-names: [];
    in-out property <[string]> conv-previews: [];
    in-out property <[int]> conv-unread: [];
    // chat
    in-out property <string> selected-friend: "";
    in-out property <[string]> chat-messages: [];
    in-out property <string> message-input: "";
    // search (filters the current list locally)
    in-out property <string> search-input: "";
    // add-friend dialog
    in-out property <bool> add-dialog-open: false;
    in-out property <string> add-search-input: "";
    in-out property <bool> add-search-in-progress: false;
    in-out property <string> add-search-result: "";
    in-out property <bool> add-search-result-is-friend: false;
    in-out property <string> add-search-status: "";
    // friend applies
    in-out property <[string]> apply-names: [];
    in-out property <[int]> apply-statuses: [];
    in-out property <string> apply-status: "";

    callback do-login();
    callback do-register();
    callback do-reset-password();
    callback request-verify-code();
    callback set-auth-mode(int);
    callback goto-chat();
    callback goto-friends();
    callback goto-new-friends();
    callback select-friend(string);
    callback send-text(string, string);
    callback open-add-dialog();
    callback close-add-dialog();
    callback add-search-user(string);
    callback add-friend();
    callback approve-apply(string);
    callback reject-apply(string);

    // ============================ AUTH SCREEN ============================
    if !root.logged-in : Rectangle {
        background: #ffffff;
        VerticalBox {
            width: 400px;
            x: (parent.width - 400px) / 2;
            y: (parent.height - 430px) / 2;
            padding: 28px;
            spacing: 10px;

            Text { text: "Iffchat"; font-size: 30px; font-weight: 700; color: #07c160; horizontal-alignment: center; }
            Text {
                text: root.auth-mode == 0 ? "登录" : (root.auth-mode == 1 ? "注册新账号" : "重置密码");
                font-size: 13px; color: #888888; horizontal-alignment: center;
            }

            Rectangle { height: 8px; }

            LineEdit {
                placeholder-text: "用户名";
                text: root.username;
                edited(text) => { root.username = text; }
            }
            if root.auth-mode != 0 : LineEdit {
                placeholder-text: "邮箱";
                text: root.email;
                edited(text) => { root.email = text; }
            }
            if root.auth-mode != 0 : HorizontalBox {
                spacing: 4px;
                LineEdit {
                    horizontal-stretch: 1;
                    placeholder-text: "验证码";
                    text: root.verify-code;
                    edited(text) => { root.verify-code = text; }
                }
                Button { text: "获取验证码"; width: 96px; clicked => { root.request-verify-code(); } }
            }
            if root.auth-mode != 2 : LineEdit {
                placeholder-text: "密码";
                text: root.password;
                edited(text) => { root.password = text; }
            }
            if root.auth-mode == 1 : LineEdit {
                placeholder-text: "确认密码";
                text: root.confirm-password;
                edited(text) => { root.confirm-password = text; }
            }

            Rectangle { height: 4px; }

            if root.auth-mode == 0 : Button { text: "登录"; clicked => { root.do-login(); } }
            if root.auth-mode == 1 : Button { text: "注册"; clicked => { root.do-register(); } }
            if root.auth-mode == 2 : Button { text: "重置密码"; clicked => { root.do-reset-password(); } }

            Rectangle { height: 2px; }
            HorizontalBox {
                spacing: 6px;
                Button { text: "登录"; clicked => { root.set-auth-mode(0); } }
                Button { text: "注册"; clicked => { root.set-auth-mode(1); } }
                Button { text: "重置密码"; clicked => { root.set-auth-mode(2); } }
            }

            Text { text: root.login-status; color: #e64c3c; font-size: 12px; horizontal-alignment: center; }
        }
    }

    // ============================ MAIN WINDOW ============================
    if root.logged-in : HorizontalBox {
        // ---- left nav ----
        Rectangle {
            width: 60px;
            background: #202a33;
            VerticalBox {
                padding-top: 14px;
                spacing: 18px;
                alignment: center;
                // avatar
                Rectangle {
                    width: 42px; height: 42px; border-radius: 21px; background: #07c160;
                    Text { text: "我"; color: white; x: 14px; y: 11px; font-size: 15px; }
                }
                // chat nav
                Rectangle {
                    width: 44px; height: 44px; border-radius: 10px;
                    background: root.page == 0 ? #07c160 : #36424d;
                    TouchArea { clicked => { root.goto-chat(); } }
                    Text { text: "💬"; color: white; x: 13px; y: 10px; font-size: 18px; }
                }
                // friends nav
                Rectangle {
                    width: 44px; height: 44px; border-radius: 10px;
                    background: root.page != 0 ? #07c160 : #36424d;
                    TouchArea { clicked => { root.goto-friends(); } }
                    Text { text: "👤"; color: white; x: 13px; y: 10px; font-size: 18px; }
                }
            }
        }

        // ---- middle column ----
        Rectangle {
            width: 280px;
            background: #f0f2f5;
            VerticalBox {
                // search + add-friend
                HorizontalBox {
                    padding: 8px;
                    spacing: 6px;
                    LineEdit {
                        horizontal-stretch: 1;
                        height: 30px;
                        placeholder-text: "🔍 搜索";
                        font-size: 13px;
                        text: root.search-input;
                        edited(text) => { root.search-input = text; }
                    }
                    Button { text: "＋"; width: 32px; height: 30px; clicked => { root.open-add-dialog(); } }
                }

                // ===== CHAT PAGE: recent conversations =====
                if root.page == 0 : ScrollView {
                    VerticalBox {
                        padding: 6px;
                        spacing: 2px;
                        alignment: start;
                        for name[idx] in root.conv-names : Rectangle {
                            height: 58px;
                            border-radius: 6px;
                            background: name == root.selected-friend ? #d9e7df : transparent;
                            TouchArea { clicked => { root.select-friend(name); } }
                            VerticalLayout { alignment: center;
                                HorizontalBox {
                                    padding: 8px;
                                    Rectangle { width: 38px; height: 38px; border-radius: 19px; background: #07c160; }
                                    Rectangle { width: 10px; }
                                    VerticalLayout {
                                        Text { text: name; font-size: 14px; color: #222222; }
                                        Text { text: idx < root.conv-previews.length ? root.conv-previews[idx] : ""; font-size: 12px; color: #999999; }
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                    if idx < root.conv-unread.length && root.conv-unread[idx] > 0 : Rectangle {
                                        width: 18px; height: 18px; border-radius: 9px; background: #e64c3c;
                                        Text { text: root.conv-unread[idx]; color: white; x: 6px; y: 3px; font-size: 10px; }
                                    }
                                }
                            }
                        }
                    }
                }

                // ===== FRIENDS PAGE: new-friends entry + contacts =====
                if root.page == 1 : ScrollView {
                    VerticalBox {
                        padding: 6px;
                        spacing: 4px;
                        alignment: start;
                        // new friends entry
                        Rectangle {
                            height: 50px;
                            border-radius: 8px;
                            background: #e6f4ea;
                            TouchArea { clicked => { root.goto-new-friends(); } }
                            VerticalLayout { alignment: center;
                                HorizontalBox {
                                    padding: 8px;
                                    Rectangle { width: 34px; height: 34px; border-radius: 17px; background: #f5a623; Text { text: "＋"; color: white; x: 10px; y: 7px; font-size: 16px; } }
                                    Rectangle { width: 10px; }
                                    Text { text: "新的朋友"; font-size: 14px; color: #1d7a3c; }
                                    Rectangle { horizontal-stretch: 1; }
                                    if root.apply-statuses.length > 0 : Rectangle {
                                        width: 18px; height: 18px; border-radius: 9px; background: #e64c3c;
                                        Text { text: root.apply-statuses.length; color: white; x: 6px; y: 3px; font-size: 10px; }
                                    }
                                }
                            }
                        }
                        Rectangle { height: 2px; background: #e3e6ea; }
                        Text { text: "联系人"; font-size: 13px; color: #888888; }
                        for name in root.friend-names : Rectangle {
                            height: 46px;
                            border-radius: 6px;
                            background: name == root.selected-friend ? #d9e7df : transparent;
                            TouchArea { clicked => { root.select-friend(name); } }
                            HorizontalBox {
                                padding: 6px;
                                VerticalBox { alignment: center; width: 44px; Rectangle { width: 34px; height: 34px; border-radius: 17px; background: #07c160; } }
                                Rectangle { width: 6px; }
                                Text { text: name; font-size: 14px; color: #222222; vertical-alignment: center; }
                            }
                        }
                    }
                }

                // ===== NEW-FRIENDS PAGE: applies =====
                if root.page == 2 : ScrollView {
                    VerticalBox {
                        padding: 6px;
                        spacing: 2px;
                        alignment: start;
                        for name[idx] in root.apply-names : Rectangle {
                            height: 60px;
                            border-radius: 6px;
                            background: transparent;
                            VerticalLayout { alignment: center;
                                HorizontalBox {
                                    padding: 8px;
                                    Rectangle { width: 38px; height: 38px; border-radius: 19px; background: #f5a623; }
                                    Rectangle { width: 10px; }
                                    VerticalLayout {
                                        Text { text: name; font-size: 14px; color: #222222; }
                                        Text { text: "请求添加你为好友"; font-size: 12px; color: #888888; }
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                    if idx < root.apply-statuses.length && root.apply-statuses[idx] == 1 : Text {
                                        text: "已添加"; font-size: 13px; color: #999999; vertical-alignment: center;
                                    }
                                    if idx < root.apply-statuses.length && root.apply-statuses[idx] == 0 : VerticalBox {
                                        alignment: center;
                                        HorizontalBox {
                                            spacing: 4px;
                                            Button { text: "拒绝"; width: 44px; clicked => { root.reject-apply(name); } }
                                            Button { text: "同意"; width: 44px; clicked => { root.approve-apply(name); } }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                if root.apply-status != "" : Text { text: root.apply-status; font-size: 12px; color: #07c160; }
            }
        }

        // ---- right chat pane ----
        Rectangle {
            horizontal-stretch: 1;
            background: #ffffff;
            VerticalBox {
                Rectangle {
                    height: 48px;
                    background: #f0f2f4;
                    Text {
                        text: root.selected-friend == "" ? "选择好友开始聊天" : root.selected-friend;
                    font-size: 15px; font-weight: 600; x: 16px; y: 16px; color: #222222;
                }
            }
            Rectangle {
                horizontal-stretch: 1;
                background: #f7f8fa;
                ScrollView {
                    width: 100%; height: 100%;
                    VerticalBox {
                        padding: 16px;
                        spacing: 12px;
                        alignment: start;
                        for msg in root.chat-messages : Rectangle {
                            background: #eef1f4;
                            border-radius: 10px;
                            width: 420px;
                            VerticalBox {
                                padding: 8px;
                                Text { text: msg; font-size: 13px; color: #333333; }
                            }
                        }
                    }
                }
            }
            // emoji/file toolbar between messages and input
            Rectangle {
                height: 34px;
                background: #ffffff;
                HorizontalBox {
                    padding-left: 12px;
                    spacing: 14px;
                    Text { text: "🙂"; font-size: 16px; y: 6px; }
                    Text { text: "📁"; font-size: 16px; y: 6px; }
                    Rectangle { horizontal-stretch: 1; }
                }
            }
            // big input
            Rectangle {
                height: 100px;
                background: #ffffff;
                TextEdit {
                    width: 100%; height: 100%;
                    placeholder-text: "输入消息…";
                    text: root.message-input;
                    edited(text) => { root.message-input = text; }
                }
            }
            // receive / send
            Rectangle {
                height: 52px;
                background: #f0f2f4;
                HorizontalBox {
                    alignment: end;
                    padding: 8px;
                    spacing: 8px;
                    Button { text: "接收"; width: 80px; }
                    Button { text: "发送"; width: 80px; clicked => { if root.message-input != "" { root.send-text(root.selected-friend, root.message-input); root.message-input = ""; } } }
                }
            }
            }
        }
    }

    // ============================ ADD-FRIEND DIALOG ============================
    if root.add-dialog-open : Rectangle {
        background: #00000088;
        Rectangle {
            width: 380px;
            height: 320px;
            x: (parent.width - 380px) / 2;
            y: (parent.height - 320px) / 2;
            background: #ffffff;
            border-radius: 12px;
            VerticalBox {
                padding: 20px;
                spacing: 12px;
                HorizontalBox {
                    Text { text: "添加好友"; font-size: 16px; font-weight: 600; color: #222222; }
                    Rectangle { horizontal-stretch: 1; }
                    Button { text: "✕"; clicked => { root.close-add-dialog(); } }
                }
                HorizontalBox {
                    spacing: 4px;
                    LineEdit {
                        horizontal-stretch: 1;
                        placeholder-text: "搜索用户名或ID";
                        text: root.add-search-input;
                        edited(text) => { root.add-search-input = text; }
                        accepted => { root.add-search-user(root.add-search-input); }
                    }
                    Button { text: "搜索"; clicked => { root.add-search-user(root.add-search-input); } }
                }
                if root.add-search-in-progress : Text { text: "搜索中…"; font-size: 12px; color: #888888; }
                if root.add-search-result != "" : Rectangle {
                    height: 46px;
                    background: #f7f8fa;
                    border-radius: 8px;
                    HorizontalBox {
                        padding: 8px;
                        Rectangle { width: 30px; height: 30px; border-radius: 15px; background: #07c160; }
                        Rectangle { width: 8px; }
                        Text { text: root.add-search-result; font-size: 14px; color: #222222; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; }
                        Button {
                            text: root.add-search-result-is-friend ? "已是好友" : "加好友";
                            enabled: !root.add-search-result-is-friend;
                            clicked => { root.add-friend(); }
                        }
                    }
                }
                if root.add-search-status != "" : Text { text: root.add-search-status; font-size: 12px; color: #e64c3c; }
            }
        }
    }
}
