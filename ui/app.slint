// Login screen + main window. Variant B layout (dark icon rail + conversation
// list + chat pane) chosen from the UI prototype. All features preserved:
// login, search, add friend, approve/ignore applies, unread markers, 1:1 chat.
import { Button, LineEdit, ScrollView, VerticalBox, HorizontalBox } from "std-widgets.slint";

export component MainWindow inherits Window {
    title: "Chat";
    width: 760px;
    height: 540px;
    background: #ffffff;

    in-out property <string> server-host: "";
    in-out property <string> username: "";
    in-out property <string> password: "";
    in-out property <string> login-status: "";
    in-out property <bool> logged-in: false;
    // auth: 0 = login, 1 = register, 2 = reset password
    in-out property <int> auth-mode: 0;
    in-out property <string> email: "";
    in-out property <string> confirm-password: "";
    in-out property <string> verify-code: "";
    in-out property <[string]> friend-names: [];
    in-out property <[int]> unread-flags: [];
    in-out property <string> selected-friend: "";
    in-out property <[string]> chat-messages: [];
    in-out property <string> message-input: "";
    // search
    in-out property <string> search-input: "";
    in-out property <bool> search-in-progress: false;
    in-out property <string> search-result: "";
    in-out property <bool> search-result-is-friend: false;
    in-out property <string> search-status: "";
    // pending friend applies
    in-out property <[string]> apply-names: [];
    in-out property <string> apply-status: "";

    callback do-login();
    callback do-register();
    callback do-reset-password();
    callback request-verify-code();
    callback set-auth-mode(int);
    callback select-friend(string);
    callback send-text(string, string);
    callback search-user(string);
    callback add-friend();
    callback approve-apply(string);
    callback reject-apply(string);

    // ============================ AUTH SCREEN (login / register / reset) ============================
    if !root.logged-in : Rectangle {
        background: #ffffff;
        VerticalBox {
            width: 400px;
            x: (parent.width - 400px) / 2;
            y: (parent.height - 430px) / 2;
            padding: 28px;
            spacing: 10px;

            Text { text: "Chat"; font-size: 30px; font-weight: 700; color: #07c160; horizontal-alignment: center; }
            Text {
                text: root.auth-mode == 0 ? "登录" : (root.auth-mode == 1 ? "注册新账号" : "重置密码");
                font-size: 13px; color: #888888; horizontal-alignment: center;
            }

            Rectangle { height: 8px; }

            LineEdit {
                placeholder-text: "服务器 host:port";
                text: root.server-host;
                edited(text) => { root.server-host = text; }
            }
            LineEdit {
                placeholder-text: "用户名";
                text: root.username;
                edited(text) => { root.username = text; }
            }
            if root.auth-mode != 0 : LineEdit {
                placeholder-text: "邮箱";
                text: root.email;
                edited(text) => { root.email = text; }
            }
            if root.auth-mode != 0 : HorizontalBox {
                spacing: 4px;
                LineEdit {
                    horizontal-stretch: 1;
                    placeholder-text: "验证码";
                    text: root.verify-code;
                    edited(text) => { root.verify-code = text; }
                }
                Button { text: "获取验证码"; clicked => { root.request-verify-code(); } }
            }
            if root.auth-mode == 1 : LineEdit {
                placeholder-text: "密码";
                text: root.password;
                edited(text) => { root.password = text; }
            }
            if root.auth-mode == 1 : LineEdit {
                placeholder-text: "确认密码";
                text: root.confirm-password;
                edited(text) => { root.confirm-password = text; }
            }
            if root.auth-mode == 2 : LineEdit {
                placeholder-text: "新密码";
                text: root.password;
                edited(text) => { root.password = text; }
            }

            Rectangle { height: 4px; }

            if root.auth-mode == 0 : Button { text: "登录"; clicked => { root.do-login(); } }
            if root.auth-mode == 1 : Button { text: "注册"; clicked => { root.do-register(); } }
            if root.auth-mode == 2 : Button { text: "重置密码"; clicked => { root.do-reset-password(); } }

            Rectangle { height: 2px; }
            HorizontalBox {
                alignment: center;
                spacing: 6px;
                Button { text: "登录"; clicked => { root.set-auth-mode(0); } }
                Button { text: "注册"; clicked => { root.set-auth-mode(1); } }
                Button { text: "重置密码"; clicked => { root.set-auth-mode(2); } }
            }

            Text { text: root.login-status; color: #e64c3c; font-size: 12px; horizontal-alignment: center; }
        }
    }

    // ============================ MAIN WINDOW (Variant B) ============================
    if root.logged-in : HorizontalBox {
        // ---- dark icon rail ----
        Rectangle {
            width: 56px;
            background: #202a33;
            VerticalBox {
                padding-top: 12px;
                spacing: 14px;
                Rectangle {
                    width: 40px; height: 40px; x: 8px;
                    border-radius: 20px; background: #07c160;
                    Text { text: "我"; color: white; x: 12px; y: 11px; font-size: 14px; }
                }
                Rectangle {
                    width: 40px; height: 40px; x: 8px;
                    border-radius: 10px; background: #07c160;
                    Text { text: "聊"; color: white; x: 13px; y: 11px; font-size: 14px; }
                }
                Rectangle {
                    width: 40px; height: 40px; x: 8px;
                    border-radius: 10px; background: #36424d;
                    Text { text: "好"; color: white; x: 13px; y: 11px; font-size: 14px; }
                }
                Rectangle {
                    width: 40px; height: 40px; x: 8px;
                    border-radius: 10px; background: #36424d;
                    Text { text: "设"; color: white; x: 13px; y: 11px; font-size: 14px; }
                }
            }
        }

        // ---- conversation / friend list column ----
        Rectangle {
            width: 240px;
            background: #f0f2f5;
            VerticalBox {
                Rectangle {
                    height: 44px;
                    background: #ffffff;
                    HorizontalBox {
                        padding: 10px;
                        Text { text: "会话"; font-size: 15px; font-weight: 600; color: #222222; }
                        Rectangle { horizontal-stretch: 1; }
                        Button { text: "＋"; width: 28px; clicked => { root.search-user(root.search-input); } }
                    }
                }

                // ---- search ----
                HorizontalBox {
                    padding: 6px;
                    spacing: 4px;
                    LineEdit {
                        horizontal-stretch: 1;
                        placeholder-text: "搜索用户名";
                        text: root.search-input;
                        edited(text) => { root.search-input = text; }
                        accepted => { root.search-user(root.search-input); }
                    }
                    Button { text: "搜索"; clicked => { root.search-user(root.search-input); } }
                }
                if root.search-in-progress : Text { text: "搜索中…"; font-size: 12px; color: #888888; x: 8px; }
                if root.search-result != "" : Rectangle {
                    height: 40px;
                    background: #ffffff;
                    border-radius: 8px;
                    HorizontalBox {
                        padding-left: 10px;
                        Text { text: root.search-result; font-size: 13px; color: #333333; y: 12px; }
                        Rectangle { horizontal-stretch: 1; }
                        Button {
                            text: root.search-result-is-friend ? "已是好友" : "加好友";
                            enabled: !root.search-result-is-friend;
                            clicked => { root.add-friend(); }
                        }
                    }
                }
                if root.search-status != "" : Text { text: root.search-status; font-size: 12px; color: #e64c3c; x: 8px; }

                Rectangle { height: 4px; }

                // ---- friend list ----
                ScrollView {
                    horizontal-stretch: 1;
                    VerticalBox {
                        padding: 6px;
                        spacing: 2px;
                        for name[idx] in root.friend-names : Rectangle {
                            height: 52px;
                            border-radius: 8px;
                            background: name == root.selected-friend ? #d9e7df : transparent;
                            TouchArea {
                                clicked => { root.select-friend(name); }
                            }
                            HorizontalBox {
                                padding: 8px;
                                Rectangle { width: 34px; height: 34px; y: 9px; border-radius: 17px; background: #07c160; }
                                Rectangle { width: 8px; }
                                VerticalBox {
                                    y: 6px;
                                    Text { text: name; font-size: 14px; color: #222222; font-weight: name == root.selected-friend ? 600 : 400; }
                                    Text { text: "最近消息…"; font-size: 11px; color: #999999; }
                                }
                                Rectangle { horizontal-stretch: 1; }
                                if idx < root.unread-flags.length && root.unread-flags[idx] == 1 : Rectangle {
                                    width: 10px; height: 10px; y: 21px; border-radius: 5px; background: #e64c3c;
                                }
                            }
                        }
                    }
                }

                if root.apply-status != "" : Text { text: root.apply-status; font-size: 12px; color: #07c160; x: 8px; }
            }
        }

        // ---- chat pane ----
        VerticalBox {
            horizontal-stretch: 1;
            // incoming friend-apply banner
            for apply in root.apply-names : Rectangle {
                height: 42px;
                background: #f8e8c8;
                HorizontalBox {
                    padding-left: 12px;
                    Text { text: apply + " 请求加你为好友"; font-size: 13px; color: #6b5313; y: 14px; }
                    Rectangle { horizontal-stretch: 1; }
                    Button { text: "同意"; clicked => { root.approve-apply(apply); } }
                    Button { text: "忽略"; clicked => { root.reject-apply(apply); } }
                }
            }
            Rectangle {
                height: 50px;
                background: #f0f2f4;
                Text { text: "与 " + root.selected-friend + " 的对话"; font-size: 15px; font-weight: 600; x: 16px; y: 17px; color: #222222; }
            }
            Rectangle {
                horizontal-stretch: 1;
                background: #ffffff;
                ScrollView {
                    width: 100%; height: 100%;
                    VerticalBox {
                        padding: 14px;
                        spacing: 8px;
                        for msg in root.chat-messages : Rectangle {
                            background: #eef1f4;
                            border-radius: 10px;
                            width: 420px;
                            VerticalBox {
                                padding: 8px;
                                Text { text: msg; font-size: 13px; color: #333333; }
                            }
                        }
                    }
                }
            }
            HorizontalBox {
                padding: 10px;
                spacing: 8px;
                LineEdit {
                    horizontal-stretch: 1;
                    placeholder-text: "输入消息…";
                    text: root.message-input;
                    edited(text) => { root.message-input = text; }
                    accepted => { if root.message-input != "" { root.send-text(root.selected-friend, root.message-input); root.message-input = ""; } }
                }
                Button {
                    text: "发送";
                    clicked => { if root.message-input != "" { root.send-text(root.selected-friend, root.message-input); root.message-input = ""; } }
                }
            }
        }
    }
}
