// THROWAWAY UI prototype — answers "what should the chat GUI look like?"
// Three structurally different main-window variants (A/B/C), a login screen, and an
// add-friend dialog, switchable via the bottom bar. All mock data, no network.
import { Button, LineEdit, ScrollView, VerticalBox, HorizontalBox } from "std-widgets.slint";

export component MainWindow inherits Window {
    title: "Chat GUI — UI prototype";
    width: 960px;
    height: 620px;
    background: #eceff3;

    // 0 = login, 1 = variant A, 2 = variant B, 3 = variant C
    in-out property <int> variant: 0;
    in-out property <bool> add-friend-open: false;
    in-out property <string> login-status: "not logged in";
    in-out property <string> selected-friend: "aaa";
    in-out property <string> input-text: "";
    in-out property <string> banner: "aaa 请求加你为好友";

    property <[string]> friends: ["aaa", "bbb", "ssss"];
    in-out property <[string]> messages: ["aaa: 你好", "我: 在吗", "aaa: 下班了?"];

    callback do-login();
    callback next-variant();
    callback prev-variant();
    callback toggle-add-friend();
    callback send-message();
    callback dismiss-banner();

    VerticalBox {
        // ============================ LOGIN SCREEN ============================
        if root.variant == 0 : Rectangle {
            background: #ffffff;
            Rectangle {
                width: 380px;
                height: 340px;
                x: (parent.width - 380px) / 2;
                y: (parent.height - 340px) / 2;
                background: #f7f8fa;
                border-radius: 12px;
                VerticalBox {
                    padding: 24px;
                    spacing: 12px;
                    Text { text: "Chat"; font-size: 28px; font-weight: 700; color: #07c160; }
                    Text { text: "连接服务器与登录"; font-size: 13px; color: #888; }
                    LineEdit { placeholder-text: "服务器 host:port"; text: "127.0.0.1:10086"; font-size: 14px; }
                    LineEdit { placeholder-text: "用户名"; text: "ssss"; font-size: 14px; }
                    LineEdit { placeholder-text: "密码"; text: "555"; input-type: password; font-size: 14px; }
                    Button {
                        text: "登录";
                        clicked => { root.do-login(); }
                    }
                    Text { text: root.login-status; color: #e64c3c; font-size: 12px; }
                }
            }
        }

        // ============================ VARIANT A — classic two-pane ============================
        if root.variant == 1 : HorizontalBox {
            // left: friend list
            Rectangle {
                width: 260px;
                background: #ffffff;
                VerticalBox {
                    HorizontalBox {
                        padding-left: 16px; padding-top: 10px; padding-bottom: 10px;
                        Rectangle { horizontal-stretch: 1; }
                        Text { text: "好友"; font-size: 16px; font-weight: 600; color: #333; }
                        Button { text: "＋"; width: 30px; clicked => { root.toggle-add-friend(); } }
                    }
                    VerticalBox {
                        padding-left: 8px; padding-right: 8px;
                        for f in root.friends : Rectangle {
                            height: 44px;
                            border-radius: 8px;
                            background: f == root.selected-friend ? #e8f5ee : #ffffff;
                            HorizontalBox {
                                padding-left: 12px;
                                Rectangle {
                                    width: 28px; height: 28px; y: 8px;
                                    border-radius: 14px;
                                    background: #07c160;
                                }
                                Rectangle { width: 10px; }
                                Text {
                                    text: f; y: 12px; font-size: 14px; color: #333;
                                }
                            }
                        }
                    }
                }
            }
            Rectangle { width: 1px; height: 100%; background: #e3e6ea; }
            // right: chat pane
            VerticalBox {
                horizontal-stretch: 1;
                Rectangle {
                    height: 48px;
                    background: #f3f5f7;
                    HorizontalBox {
                        padding-left: 16px;
                        Text { text: "与 " + root.selected-friend + " 的对话"; font-size: 15px; font-weight: 600; color: #333; }
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                    ScrollView {
                        width: 100%; height: 100%;
                        VerticalBox {
                            padding: 12px;
                            spacing: 8px;
                            for m in root.messages : Text { text: m; font-size: 14px; color: #444; }
                        }
                    }
                }
                HorizontalBox {
                    padding: 10px;
                    spacing: 8px;
                    LineEdit {
                        horizontal-stretch: 1;
                        text: root.input-text;
                        placeholder-text: "输入消息…";
                        font-size: 14px;
                        accepted => { root.input-text = self.text; root.send-message(); }
                    }
                    Button { text: "发送"; clicked => { root.input-text = root.input-text; root.send-message(); } }
                }
            }
        }

        // ============================ VARIANT B — icon sidebar + conversation list ============================
        if root.variant == 2 : HorizontalBox {
            Rectangle {
                width: 60px;
                background: #2e3a4a;
                VerticalBox {
                    padding-top: 12px;
                    Rectangle {
                        width: 40px; height: 40px; x: 10px;
                        border-radius: 20px; background: #07c160;
                        Text { text: "我"; color: white; x: 14px; y: 10px; font-size: 14px; }
                    }
                    Rectangle { height: 16px; }
                    Rectangle { width: 40px; height: 40px; x: 10px; border-radius: 8px; background: #07c160; Text { text: "聊"; color: white; x: 14px; y: 11px; font-size: 14px; } }
                    Rectangle { width: 40px; height: 40px; x: 10px; border-radius: 8px; background: #45566b; Text { text: "好"; color: white; x: 14px; y: 11px; font-size: 14px; } }
                    Rectangle { width: 40px; height: 40px; x: 10px; border-radius: 8px; background: #45566b; Text { text: "＋"; color: white; x: 14px; y: 11px; font-size: 14px; } }
                }
            }
            Rectangle {
                width: 240px;
                background: #f0f2f5;
                VerticalBox {
                    HorizontalBox {
                        padding: 10px;
                        Rectangle { horizontal-stretch: 1; }
                        Button { text: "＋"; clicked => { root.toggle-add-friend(); } }
                    }
                    for f in root.friends : Rectangle {
                        height: 56px;
                        border-radius: 8px;
                        background: f == root.selected-friend ? #d9e7df : #f0f2f5;
                        HorizontalBox {
                            padding-left: 10px;
                            Rectangle { width: 36px; height: 36px; y: 10px; border-radius: 18px; background: #07c160; }
                            Rectangle { width: 10px; }
                            VerticalBox { y: 6px; Text { text: f; font-size: 14px; color: #333; } Text { text: "最近消息…"; font-size: 12px; color: #999; } }
                        }
                    }
                }
            }
            VerticalBox {
                horizontal-stretch: 1;
                Rectangle {
                    height: 40px;
                    background: #d8d2c4;
                    HorizontalBox { padding-left: 12px; Text { text: root.banner; font-size: 13px; color: #5a4a32; } Rectangle { horizontal-stretch: 1; } Button { text: "同意"; } Button { text: "忽略"; } }
                }
                Rectangle {
                    height: 48px; background: #f3f5f7;
                    Text { text: "与 " + root.selected-friend + " 的对话"; font-size: 15px; font-weight: 600; x: 16px; y: 14px; color: #333; }
                }
                Rectangle {
                    horizontal-stretch: 1;
                    ScrollView {
                        width: 100%; height: 100%;
                        VerticalBox { padding: 12px; spacing: 8px; for m in root.messages : Text { text: m; font-size: 14px; color: #444; } }
                    }
                }
                HorizontalBox {
                    padding: 10px; spacing: 8px;
                    LineEdit { horizontal-stretch: 1; placeholder-text: "输入消息…"; font-size: 14px; }
                    Button { text: "发送"; }
                }
            }
        }

        // ============================ VARIANT C — chat-first, collapsible contacts ============================
        if root.variant == 3 : HorizontalBox {
            Rectangle {
                width: 200px;
                background: #ffffff;
                VerticalBox {
                    Rectangle { width: 1px; height: 100%; x: parent.width - 1px; background: #e3e6ea; }
                    padding: 10px;
                    spacing: 6px;
                    Text { text: "联系人"; font-size: 15px; font-weight: 600; color: #333; }
                    for f in root.friends : Rectangle {
                        height: 40px;
                        border-radius: 8px;
                        background: f == root.selected-friend ? #e8f5ee : #ffffff;
                        HorizontalBox { padding-left: 10px; Rectangle { width: 24px; height: 24px; y: 8px; border-radius: 12px; background: #07c160; } Rectangle { width: 8px; } Text { text: f; y: 10px; font-size: 14px; color: #333; } }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Button { text: "＋ 加好友"; clicked => { root.toggle-add-friend(); } }
                }
            }
            VerticalBox {
                horizontal-stretch: 1;
                Rectangle {
                    height: 52px;
                    background: #f7f7f7;
                    HorizontalBox {
                        padding-left: 16px;
                        Rectangle {
                            width: 18px; height: 18px; y: 17px; border-radius: 9px; background: #e64c3c;
                            Text { text: "1"; color: white; x: 6px; y: 2px; font-size: 10px; }
                        }
                        Rectangle { width: 8px; }
                        Text { text: "与 " + root.selected-friend + " 的对话"; font-size: 15px; font-weight: 600; y: 16px; color: #333; }
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                    ScrollView {
                        width: 100%; height: 100%;
                        VerticalBox {
                            padding: 12px; spacing: 8px;
                            for m in root.messages : HorizontalBox {
                                Rectangle {
                                    background: #ffffff;
                                    border-radius: 6px;
                                    VerticalBox {
                                        padding: 8px;
                                        Text {
                                            text: m;
                                            font-size: 14px; color: #444;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                HorizontalBox {
                    padding: 10px; spacing: 8px;
                    LineEdit { horizontal-stretch: 1; placeholder-text: "输入消息…"; font-size: 14px; }
                    Button { text: "发送"; }
                }
            }
        }

        // ============================ BOTTOM SWITCHER BAR ============================
        Rectangle {
            height: 44px;
            background: #222b36;
            HorizontalBox {
                spacing: 8px;
                padding: 8px;
                Button { text: "◀"; clicked => { root.prev-variant(); } }
                Text {
                    text: root.variant == 0 ? "登录" : (root.variant == 1 ? "A — 经典双栏" : (root.variant == 2 ? "B — 图标侧栏" : "C — 聊天优先"));
                    color: white; font-size: 13px; y: 12px;
                }
                Button { text: "▶"; clicked => { root.next-variant(); } }
                Rectangle { horizontal-stretch: 1; }
                Text {
                    text: "状态: " + root.login-status;
                    color: #9fb3c8; font-size: 12px; y: 13px;
                }
            }
        }
    }

    // ============================ ADD-FRIEND DIALOG (shared overlay) ============================
    if root.add-friend-open : Rectangle {
        background: #00000088;
        Rectangle {
            width: 420px;
            height: 300px;
            x: (parent.width - 420px) / 2;
            y: (parent.height - 300px) / 2;
            background: #ffffff;
            border-radius: 12px;
            VerticalBox {
                padding: 20px;
                spacing: 12px;
                HorizontalBox {
                    Text { text: "添加好友"; font-size: 17px; font-weight: 600; color: #333; }
                    Rectangle { horizontal-stretch: 1; }
                    Button { text: "✕"; clicked => { root.toggle-add-friend(); } }
                }
                LineEdit { placeholder-text: "搜索用户名或 uid"; font-size: 14px; }
                Rectangle {
                    height: 44px;
                    background: #f7f8fa;
                    border-radius: 8px;
                    HorizontalBox { padding-left: 10px; Text { text: "搜索结果: aaa"; font-size: 14px; color: #444; } Rectangle { horizontal-stretch: 1; } Button { text: "发送申请"; } }
                }
                Text { text: "搜索结果空,或申请已发送。真实功能等接入协议后实现。"; font-size: 12px; color: #999; }
            }
        }
    }
}
