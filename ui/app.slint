// Login screen + main window. Tickets 1-3: real login, friend list, 1:1 text chat.
import { Button, LineEdit, VerticalBox, HorizontalBox } from "std-widgets.slint";

export component MainWindow inherits Window {
    title: "Chat";
    width: 760px;
    height: 540px;
    background: #ffffff;

    in-out property <string> server-host: "";
    in-out property <string> username: "";
    in-out property <string> password: "";
    in-out property <string> login-status: "";
    in-out property <bool> logged-in: false;
    in-out property <[string]> friend-names: [];
    in-out property <[int]> unread-flags: [];
    in-out property <string> selected-friend: "";
    in-out property <[string]> chat-messages: [];
    in-out property <string> message-input: "";

    callback do-login();
    callback select-friend(string);
    callback send-text(string, string);

    // ============================ LOGIN SCREEN ============================
    if !root.logged-in : Rectangle {
        background: #ffffff;
        VerticalBox {
            width: 380px;
            x: (parent.width - 380px) / 2;
            y: (parent.height - 340px) / 2;
            padding: 32px;
            spacing: 12px;

            Text { text: "Chat"; font-size: 30px; font-weight: 700; color: #07c160; horizontal-alignment: center; }
            Text { text: "连接服务器并登录"; font-size: 13px; color: #888888; horizontal-alignment: center; }

            Rectangle { height: 12px; }

            LineEdit {
                placeholder-text: "服务器 host:port";
                text: root.server-host;
                edited(text) => { root.server-host = text; }
            }
            LineEdit {
                placeholder-text: "用户名";
                text: root.username;
                edited(text) => { root.username = text; }
            }
            LineEdit {
                placeholder-text: "密码";
                text: root.password;
                edited(text) => { root.password = text; }
            }

            Button {
                text: "登录";
                clicked => { root.do-login(); }
            }

            Text { text: root.login-status; color: #e64c3c; font-size: 12px; horizontal-alignment: center; }
        }
    }

    // ============================ MAIN WINDOW ============================
    if root.logged-in : HorizontalBox {
        Rectangle {
            width: 240px;
            background: #f5f6f7;
            VerticalBox {
                Rectangle { height: 36px; Text { text: "好友"; font-size: 15px; font-weight: 600; color: #333333; x: 8px; y: 10px; } }
                for name[idx] in root.friend-names : Rectangle {
                    height: 44px;
                    border-radius: 8px;
                    background: name == root.selected-friend ? #d9e7df : #f5f6f7;
                    TouchArea {
                        clicked => { root.select-friend(name); }
                    }
                    HorizontalBox {
                        padding-left: 12px;
                        Rectangle { width: 28px; height: 28px; y: 8px; border-radius: 14px; background: #07c160; }
                        Rectangle { width: 8px; }
                        Text {
                            text: name;
                            y: 14px;
                            font-size: 14px;
                            color: #333333;
                            font-weight: name == root.selected-friend ? 600 : 400;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        if idx < root.unread-flags.length && root.unread-flags[idx] == 1 : Rectangle {
                            width: 10px; height: 10px; y: 17px; border-radius: 5px; background: #e64c3c;
                        }
                    }
                }
            }
        }
        Rectangle { width: 1px; height: 100%; background: #e3e6ea; }
        VerticalBox {
            horizontal-stretch: 1;
            Rectangle {
                height: 48px;
                background: #f3f5f7;
                Text { text: "与 " + root.selected-friend + " 的对话"; font-size: 15px; font-weight: 600; x: 16px; y: 16px; color: #333333; }
            }
            Rectangle {
                horizontal-stretch: 1;
                background: #ffffff;
                VerticalBox {
                    padding: 12px;
                    spacing: 8px;
                    for msg in root.chat-messages : Rectangle {
                        background: #f0f2f5;
                        border-radius: 6px;
                        Text { text: msg; font-size: 14px; color: #444444; x: 10px; y: 8px; }
                    }
                }
            }
            HorizontalBox {
                padding: 10px;
                spacing: 8px;
                LineEdit {
                    horizontal-stretch: 1;
                    placeholder-text: "输入消息…";
                    text: root.message-input;
                    edited(text) => { root.message-input = text; }
                    accepted => { if root.message-input != "" { root.send-text(root.selected-friend, root.message-input); root.message-input = ""; } }
                }
                Button {
                    text: "发送";
                    clicked => { if root.message-input != "" { root.send-text(root.selected-friend, root.message-input); root.message-input = ""; } }
                }
            }
        }
    }
}
